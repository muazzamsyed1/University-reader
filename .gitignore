# ============================================================
# PRIVATE / SENSITIVE FILES — never upload these
# ============================================================

# Environment variables (secrets, API keys, DB credentials)
.env
.env.*
*.env
.env.local
.env.production
.env.staging
.env.development

# Allow the example template (has NO real secrets)
!.env.example

# Private keys / certificates / credential files
*.key
*.pem
*.p12
*.pfx
*.crt
secrets/
credentials.json
service-account*.json

# Local agent / editor tooling
.claude/
*.local

# Build / export artifacts
*.zip

# Private source workbooks — these contain student personal data (names, emails,
# phone numbers, passwords). NEVER commit anything from here.
countriesEXCELsheetsData/private/
*student*.xlsx
*Student*.xlsx
*clients*.xlsx

# Countries Excel / data sheets (publishable catalogues are force-added, see README)
countriesEXCELsheetsData/*.xls
countriesEXCELsheetsData/*.csv
countriesEXCELsheetsData/.env

# Database files (SQLite)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# PostgreSQL dump / backup files
*.sql
# ...but the catalogue snapshot (no admin accounts, no API keys) is shareable
!database/study_abroad_data.sql
*.dump
*.pgdump
*.backup
pg_dump/
db_backups/

# ============================================================
# PYTHON
# ============================================================

# Virtual environment
venv/
.venv/
env/
ENV/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json

# ============================================================
# ALEMBIC
# ============================================================

# Keep alembic migration scripts but ignore local db used for testing
alembic.ini.local

# ============================================================
# IDE / EDITOR
# ============================================================

.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# LOGS & TEMP FILES
# ============================================================

*.log
*.tmp
*.temp
logs/

# ============================================================
# NODE / FRONTEND (if applicable)
# ============================================================

frontend/node_modules/
frontend/.env
frontend/.env.*
frontend/dist/
frontend/build/
